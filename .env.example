# ==============================================================================
# WELDING SHOP BILLING & POS SYSTEM — CLIENT ENVIRONMENT CONFIGURATION
# Copy this file to .env.local on your deployment server or local computer
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CUSTOMER SUPABASE (PostgreSQL) CONFIGURATION
# The customer creates a free project at https://supabase.com
# Find these keys in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional: Direct PostgreSQL connection string for Prisma ORM or DB CLI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SECRETS
# Generate random 32-character keys for production session hashing
# ------------------------------------------------------------------------------
NODE_ENV="production"
AUTH_SECRET="change-this-to-a-secure-random-32-character-secret"
API_AUTH_SECRET="change-this-to-a-secure-random-api-token"

# ------------------------------------------------------------------------------
# 3. META WHATSAPP BUSINESS CLOUD API (OPTIONAL)
# Required only if you want automatic PDF invoice document dispatch.
# If left blank, the system automatically provides a 1-tap manual PDF download
# and pre-formatted WhatsApp chat sharing.
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_GRAPH_API_VERSION="v21.0"
# Optional: Approved Meta document template name for 24-hour window bypass (e.g., "tax_invoice_document")
WHATSAPP_DOCUMENT_TEMPLATE_NAME=""
# Webhook verification token for delivery status tracking (sent, delivered, read)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="jaimatadi_whatsapp_webhook_token_2026"

# ------------------------------------------------------------------------------
# 4. WORKSHOP DEFAULT IDENTITY & BRANDING (English Romanized)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SHOP_NAME="JAI MATA DI STEEL FURNITURE & RAILING"
NEXT_PUBLIC_SHOP_OWNER="Mr. Vaibhav Wagh"
NEXT_PUBLIC_SHOP_PHONE="9561482326"
NEXT_PUBLIC_SHOP_ADDRESS="Naggaon Road, Bodwad, Dist. Jalgaon"
